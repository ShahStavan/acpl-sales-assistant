# Copy to .env and fill in.  .env is git-ignored; never commit a key.

# --- service ------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO

# --- data ---------------------------------------------------------------
ACPL_DATA_DIR=data/fmcg-sales-copilot-ai-engineer-mid-4to6
ACPL_WAREHOUSE=warehouse.duckdb

# --- LLM provider (the operator's OWN key) ------------------------------
# The service routes /ask through this provider only.  It never uses the
# OpenCode build token (CADRA_TOKEN) or the Cadra proxy; those are for the
# coding assistant, not the deployed service.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# Optional: override the provider's default OpenAI-compatible endpoint.
LLM_BASE_URL=
# Per-request timeout for provider calls, seconds.
LLM_TIMEOUT_S=30

# --- OpenCode only (not read by the service) ----------------------------
# CADRA_TOKEN=
