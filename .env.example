# Copy to .env and fill in.  .env is git-ignored; never commit a key.

# --- service ------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO

# --- data ---------------------------------------------------------------
ACPL_DATA_DIR=data/fmcg-sales-copilot-ai-engineer-mid-4to6
ACPL_WAREHOUSE=warehouse.duckdb

# --- LLM provider (the operator's OWN key) ------------------------------
# The service routes /ask through this provider only.  It never uses the
# OpenCode build token (CADRA_TOKEN) or the Cadra proxy; those are for the
# coding assistant, not the deployed service.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# Optional: override the provider's default OpenAI-compatible endpoint.
LLM_BASE_URL=
# Per-request timeout for provider calls, seconds.
LLM_TIMEOUT_S=30

# --- fallback chain and circuit breaker ---------------------------------
# Models tried, in order, when LLM_MODEL reports itself unavailable: rate
# limited, timed out, 5xx, or 404.  Each model id carries its own free-tier
# daily allowance, so a chain is what lets a full evaluation run finish on a
# free key.  A call that falls back is priced against the model that served it
# and names that model in the response's `models` field, so a degraded run is
# never reported as if it were a clean one.  Leave empty for no fallback.
#
# Verified against this endpoint on 2026-09-12 with the current key. gemini-2.5-flash-lite
# and gemini-2.5-pro both 404 ("no longer available to new users"), so neither belongs in a
# chain. The rest were each confirmed to answer this service's exact request shape, and are
# ordered by list price ascending: a degraded run should step down to the cheapest model
# that can still answer, not the next one that happens to be named.
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash
# Consecutive faults that take a model out of rotation, and for how long.
# Cooldown 0 disables skipping: every model is tried on every call.
LLM_BREAKER_THRESHOLD=2
LLM_BREAKER_COOLDOWN_S=300

# --- OpenCode only (not read by the service) ----------------------------
# CADRA_TOKEN=
