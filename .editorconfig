root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,toml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[data/**]
# Provided data pack: editors must not normalise it.
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
